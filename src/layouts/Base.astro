---
// Markdown pages pass their frontmatter; other layouts pass props directly.
const { heading, emoji } = Astro.props.frontmatter ?? Astro.props;
const headingClass = emoji ? `u-heading-h2 u-emoji u-emoji--${emoji}` : 'u-heading-h2';
---
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>SteveHeyes.co.uk</title>

  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">
  <link rel="preconnect" href="https://fonts.bunny.net">
  <link href="https://fonts.bunny.net/css?family=atkinson-hyperlegible:400,400i,700" rel="stylesheet" />

  <link rel="stylesheet" href="/assets/css/1.settings.css" />
  <link rel="stylesheet" href="/assets/css/2.reset.css" />
  <link rel="stylesheet" href="/assets/css/3.elements.css" />
  <link rel="stylesheet" href="/assets/css/4.objects.css" />
  <link rel="stylesheet" href="/assets/css/5.components.css" />
</head>

<body>
  <section class="grid">
    <div class="grid__nav">
      <ul class="list-inline">
        <li class="list_inline__item">
          <a class="u-emoji u-emoji--small u-emoji--man" href="/about/">
            About
          </a>
        </li>
        <li class="list_inline__item">
          <a class="u-emoji u-emoji--small u-emoji--dart" href="/now/">
            Now
          </a>
        </li>
        <li class="list_inline__item">
          <a class="u-emoji u-emoji--small u-emoji--laptop" href="/uses/">
            Uses
          </a>
        </li>
      </ul>
    </div>

    <div class="grid__title">
      <header>
        <p>
          <a href="/" class="u-huge">
            Steve Heyes
          </a>
        </p>

        <h1 class={headingClass}>{heading}</h1>
      </header>
    </div>

    <div class="grid__aside">
      <div class="avatar">
        <img src="/assets/images/avatar.png" alt="A picture of Steve Heyes with a nice brick wall in the background" />
      </div>
    </div>

    <div class="grid__main o-typography">
      <slot />
    </div>

    <div class="grid__footer">
      <footer class="u-emoji u-emoji--handshake">
        Find me on: <a href="https://keybase.io/mrsteveheyes">Keybase</a> /
        <a href="https://github.com/mrsteveheyes">Github</a> /
        <a href="https://www.linkedin.com/in/steveheyes/">LinkedIn</a>
      </footer>
    </div>
  </section>
</body>

</html>
