---
import { buildVersion } from '../build-version';

// Markdown pages pass their frontmatter; other layouts pass props directly.
const { heading, emoji } = Astro.props.frontmatter ?? Astro.props;
const headingClass = emoji ? `c-intro u-emoji u-emoji--${emoji}` : 'c-intro';

const navItems = [
  { href: '/about/', label: 'About', emoji: 'man' },
  { href: '/now/', label: 'Now', emoji: 'dart' },
  { href: '/uses/', label: 'Uses', emoji: 'laptop' },
];
const currentPath = Astro.url.pathname;

// Stylesheets are served from public/ with a long cache, so tag them with
// the build time to make browsers fetch fresh CSS after each deploy.
const stylesheets = ['1.settings', '2.reset', '3.elements', '4.objects', '5.components'];
---
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>SteveHeyes.co.uk</title>

  <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">
  <link rel="preconnect" href="https://fonts.bunny.net">
  <link href="https://fonts.bunny.net/css?family=atkinson-hyperlegible:400,400i,700" rel="stylesheet" />

  {stylesheets.map((name) => (
    <link rel="stylesheet" href={`/assets/css/${name}.css?v=${buildVersion}`} />
  ))}
</head>

<body>
  <section class="grid">
    <nav class="grid__nav">
      <ul class="list-inline">
        {navItems.map(({ href, label, emoji }) => (
          <li class="list-inline__item">
            <a class={`u-emoji u-emoji--small u-emoji--${emoji}`} href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="grid__title">
      <header>
        <p class="c-name">
          <a href="/">Steve Heyes</a>
        </p>

        <h1 class={headingClass}>{heading}</h1>
      </header>
    </div>

    <div class="grid__aside">
      <div class="avatar">
        <img src="/assets/images/avatar.png" alt="A picture of Steve Heyes with a nice brick wall in the background" />
      </div>
    </div>

    <div class="grid__main o-typography">
      <slot />
    </div>

    <div class="grid__footer">
      <footer>
        <ul class="list-inline list-inline--start">
          <li class="list-inline__item"><a href="https://keybase.io/mrsteveheyes">Keybase</a></li>
          <li class="list-inline__item"><a href="https://github.com/mrsteveheyes">GitHub</a></li>
          <li class="list-inline__item"><a href="https://www.linkedin.com/in/steveheyes/">LinkedIn</a></li>
        </ul>
      </footer>
    </div>
  </section>
</body>

</html>
